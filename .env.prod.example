# Canlı ortam için — bu dosyayı `.env` olarak kopyala (docker-compose.prod.yml
# ile AYNI dizinde), gerçek değerleri doldur. `.env` .gitignore'da, asla
# commit edilmez.
#
# packages/backend/.env.example (geliştirme) ile KARIŞTIRMA — o yerel
# `npm run start:dev` içindir, bu dosya docker-compose.prod.yml'in okuduğu
# değişkenlerdir.

POSTGRES_USER=asb
POSTGRES_PASSWORD=guclu-bir-sifre-yaz-buraya
POSTGRES_DB=asb_platform

# En az 32 karakter olmalı — main.ts'teki adminPanelSecret() kontrolü aksi
# halde uygulamayı başlangıçta bilerek çökertir.
JWT_SECRET=uretimde-kullanilacak-uzun-rastgele-bir-anahtar
ADMIN_PANEL_SECRET=uretimde-kullanilacak-en-az-32-karakterlik-baska-bir-anahtar

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
