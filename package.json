{
  "name": "asb-platform",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=@asb/backend",
    "dev:mobile": "npm run start --workspace=@asb/mobile",
    "build": "npm run build --workspace=@asb/shared-types && npm run build --workspace=@asb/backend",
    "lint": "npm run lint --workspace=@asb/backend",
    "test": "npm run test --workspace=@asb/backend"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
