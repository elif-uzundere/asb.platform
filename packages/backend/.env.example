DATABASE_URL="postgresql://asb:asb@localhost:5434/asb_platform?schema=public"
PORT=3000
JWT_SECRET="gelistirme-ortami-icin-gizli-anahtar-degistir"
ADMIN_PANEL_SECRET="gelistirme-ortaminda-admin-paneli-icin-gizli-anahtar-degistir"
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=

# Google ile Giriş — console.cloud.google.com'da "ASB Platform" projesi
# altında OAuth 2.0 Client ID'ler (Web + Android). Herkes kendi
# geliştirme makinesinde ayrı bir Android Client ID'ye ihtiyaç duyar
# (paket adı com.asb.asbapp + kendi debug.keystore SHA-1'in ile), Web
# Client ID ortak kullanılabilir.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=