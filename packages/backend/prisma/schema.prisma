// ASB Platform — Veritabanı Şeması
// Kaynak: docs/teknikPlan.md Bölüm 4 (15 tablo, FAZ 0'da tek seferde tanımlandı)
// Bu dosya ortaktır — modül bazlı bölünmez (CLAUDE.md kural 4)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 4.1 Kullanıcı ve Firma ──────────────────────────────────────────────

enum KullaniciRolu {
  ziyaretci
  firma_calisani
  firma_yetkilisi
  admin
  cookzone_yetkilisi
  palet_tesisi_yetkilisi
  // Acil durum bildirimleri türe göre ekibe düşer. tekin_isg_ekibi dış
  // sağlık firması, sirket_isg_ekibi ASB'nin kendi İSG ekibi. İkisi ayrı,
  // karıştırma.
  itfaiye_ekibi
  guvenlik_ekibi
  tekin_isg_ekibi
  kantar_ekibi
  gumruk_ekibi
  sirket_isg_ekibi
}

// Rol bazlı ince taneli yetkiler (bkz. shared/web/yetki.guard.ts). KullaniciRolu
// "kim olduğunu", RolYetki "neye izinli olduğunu" tanımlar — ileride bir role
// yeni bir işlem yetkisi tanımlanmak istendiğinde kod değişikliği değil,
// sadece yeni bir RolYetki satırı yeterli olur.
enum Yetki {
  duyuru_yonet
  // İkinci El ilanı girme izni. Departman rolü değil, RolYetki ile
  // herhangi bir role admin panelinden atanabilir.
  ikinci_el_yonet
  // Aynı yetki deseni İş İlanları/Cookzone/Palet Tesisi'ne de uygulandı.
  // Firma ve Banner zaten admin-only olduğu için bunlara eklenmedi.
  is_ilani_yonet
  cookzone_yonet
  palet_tesisi_yonet
}

model RolYetki {
  id    String        @id @default(uuid())
  rol   KullaniciRolu
  yetki Yetki

  @@unique([rol, yetki])
  @@map("rol_yetki")
}

model Kullanici {
  id               String        @id @default(uuid())
  email            String        @unique @db.VarChar(150)
  telefon          String?       @unique @db.VarChar(20)
  sifreHash        String?       @map("sifre_hash") @db.VarChar(255)
  ad               String        @db.VarChar(60)
  soyad            String        @db.VarChar(60)
  firmaId          String?       @map("firma_id")
  firma            Firma?        @relation(fields: [firmaId], references: [id])
  rol              KullaniciRolu
  epostaDogrulandi Boolean       @default(false) @map("eposta_dogrulandi")
  olusturmaTarihi  DateTime      @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime      @updatedAt @map("guncelleme_tarihi")

  // firmaId ile aynı ilişki değil, ayrı bir alan. Cookzone bir firmaya değil
  // doğrudan ASB'ye bağlı, o yüzden sahte bir Firma kaydı açmak yerine kendi
  // FK'sı var. Sadece rol = cookzone_yetkilisi hesaplarda dolu olur.
  cookzoneIsletmeId String?          @map("cookzone_isletme_id")
  cookzoneIsletme   CookzoneIsletme? @relation(fields: [cookzoneIsletmeId], references: [id])

  olusturduguDuyurular  Duyuru[]             @relation("DuyuruOlusturanKullanici")
  isIlanlariOlusturan   IsIlani[]            @relation("IsIlaniOlusturanKullanici")
  isBasvurulari         IsBasvurusu[]
  ikinciElIlanlari      IkinciElIlani[]
  cookzoneSiparisleri   CookzoneSiparis[]
  acilDurumBildirimleri AcilDurumBildirimi[]
  paletTesisleri        PaletTesisi[]
  destekTalepleri       DestekTalebi[]
  cihazTokenleri        CihazTokeni[]
  favoriler             Favori[]

  @@map("kullanici")
}

// ── Favoriler ─────────────────────────────────────────────────────────────
// İkinci El/Firma/İş İlanı için tek ortak tablo. Kayıt şekli hep aynı (kim,
// ne zaman, hangi hedef), sadece hedef türü değişiyor. hedefId gerçek bir
// foreign key değil çünkü 3 farklı tablodan birine işaret edebiliyor,
// doğrulama application katmanında yapılıyor.
enum FavoriHedefTuru {
  ikinci_el
  firma
  is_ilani
}

model Favori {
  id              String          @id @default(uuid())
  kullaniciId     String          @map("kullanici_id")
  kullanici       Kullanici       @relation(fields: [kullaniciId], references: [id])
  hedefTuru       FavoriHedefTuru @map("hedef_turu")
  hedefId         String          @map("hedef_id")
  olusturmaTarihi DateTime        @default(now()) @map("olusturma_tarihi")

  // Aynı kullanıcı aynı hedefi iki kez favorileyemez — "kalp" butonu toggle
  // çalıştığı için bu constraint idempotent davranışı garanti eder.
  @@unique([kullaniciId, hedefTuru, hedefId])
  @@map("favori")
}

enum FirmaOnayDurumu {
  beklemede
  onaylandi
  reddedildi
}

model Firma {
  id               String          @id @default(uuid())
  ad               String          @db.VarChar(150)
  logoUrl          String?         @map("logo_url") @db.VarChar(255)
  sektor           String          @db.VarChar(80)
  adres            String          @db.VarChar(255)
  telefon          String?         @db.VarChar(20)
  eposta           String?         @db.VarChar(150)
  onayDurumu       FirmaOnayDurumu @default(beklemede) @map("onay_durumu")
  aktif            Boolean         @default(true)
  webAdres         String?         @map("web_adres") @db.VarChar(255)
  kurulusTarihi    DateTime?       @map("kurulus_tarihi")
  personelSayisi   Int?            @map("personel_sayisi")
  olusturmaTarihi  DateTime        @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime        @default(now()) @updatedAt @map("guncelleme_tarihi")

  calisanlar     Kullanici[]
  isIlanlari     IsIlani[]
  bolgeNoktalari BolgeNoktasi[]

  @@map("firma")
}

// ── 4.2 Ana Sayfa İçerikleri ─────────────────────────────────────────────

model Banner {
  id        String  @id @default(uuid())
  gorselUrl String  @map("gorsel_url") @db.VarChar(255)
  linkUrl   String? @map("link_url") @db.VarChar(255)
  sira      Int
  aktif     Boolean @default(true)

  @@map("banner")
}

model Duyuru {
  id                   String    @id @default(uuid())
  baslik               String    @db.VarChar(200)
  icerik               String
  kategori             String?   @db.VarChar(60)
  yayinTarihi          DateTime  @default(now()) @map("yayin_tarihi")
  // Alan adı olusturanKullaniciId, DB kolonu hâlâ olusturan_admin_id. İsim
  // önce sadece admin oluşturabilir varsayımıyla verilmişti, duyuru_yonet
  // yetkisiyle başka roller de oluşturabildiği için genelleştirildi. DB'de
  // taşıma gerekmiyor, @map aynı kalıyor.
  olusturanKullaniciId String    @map("olusturan_admin_id")
  olusturanKullanici   Kullanici @relation("DuyuruOlusturanKullanici", fields: [olusturanKullaniciId], references: [id])

  @@map("duyuru")
}

enum DestekTalebiDurumu {
  beklemede
  yanitlandi
  kapali
}

model DestekTalebi {
  id              String             @id @default(uuid())
  baslik          String             @db.VarChar(150)
  aciklama        String
  durum           DestekTalebiDurumu @default(beklemede)
  olusturmaTarihi DateTime           @default(now()) @map("olusturma_tarihi")

  kullaniciId String    @map("kullanici_id")
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id])

  @@map("destek_talebi")
}

model IsOrtagi {
  id       String  @id @default(uuid())
  ad       String  @db.VarChar(150)
  logoUrl  String  @map("logo_url") @db.VarChar(255)
  kategori String? @db.VarChar(80)

  @@map("is_ortagi")
}

// ── 4.3 İş İlanları (Faz 2) ──────────────────────────────────────────────

enum IsIlaniDurumu {
  aktif
  kapali
}

model IsIlani {
  id                   String        @id @default(uuid())
  firmaId              String        @map("firma_id")
  firma                Firma         @relation(fields: [firmaId], references: [id])
  baslik               String        @db.VarChar(150)
  aciklama             String
  konum                String?       @db.VarChar(150)
  yayinTarihi          DateTime      @default(now()) @map("yayin_tarihi")
  durum                IsIlaniDurumu @default(aktif)
  olusturanKullaniciId String        @map("olusturan_kullanici_id")
  olusturanKullanici   Kullanici     @relation("IsIlaniOlusturanKullanici", fields: [olusturanKullaniciId], references: [id])

  basvurular IsBasvurusu[]

  @@map("is_ilani")
}

enum IsBasvurusuDurumu {
  beklemede
  incelendi
  reddedildi
  kabul
}

model IsBasvurusu {
  id            String            @id @default(uuid())
  isIlaniId     String            @map("is_ilani_id")
  isIlani       IsIlani           @relation(fields: [isIlaniId], references: [id])
  kullaniciId   String            @map("kullanici_id")
  kullanici     Kullanici         @relation(fields: [kullaniciId], references: [id])
  basvuruTarihi DateTime          @default(now()) @map("basvuru_tarihi")
  durum         IsBasvurusuDurumu @default(beklemede)
  cvUrl         String?           @map("cv_url")

  @@map("is_basvurusu")
}

// ── 4.4 İkinci El Pazar (Faz 2) ──────────────────────────────────────────

enum IkinciElIlaniDurumu {
  aktif
  satildi
  pasif
}

model IkinciElIlani {
  id              String              @id @default(uuid())
  kullaniciId     String              @map("kullanici_id")
  kullanici       Kullanici           @relation(fields: [kullaniciId], references: [id])

  baslik          String              @db.VarChar(150)
  aciklama        String
  fiyat           Decimal             @db.Decimal(10, 2)
  kategori        String              @db.VarChar(80)

  urunDurumu      String              @map("urun_durumu") @db.VarChar(50)

  // Zorunlu alan — ilan sahibiyle iletişim için.
  iletisimTelefonu String             @map("iletisim_telefonu") @db.VarChar(20)

  fotografUrls    String[]            @map("fotograf_urls")

  // Ana sayfa "Öne Çıkanlar" bölümünde gösterilecek ilanları işaretlemek için
  // — sadece admin panelinden değiştirilir, ilan sahibi kendi ilanını öne
  // çıkaramaz.
  oneCikan        Boolean             @default(false) @map("one_cikan")

  durum           IkinciElIlaniDurumu @default(aktif)
  olusturmaTarihi DateTime            @default(now()) @map("olusturma_tarihi")

  @@map("ikinci_el_ilani")
}

// ── 4.5 Bölge İçi Navigasyon (Faz 2) ─────────────────────────────────────

enum BolgeNoktasiTuru {
  firma
  giris_cikis
  ortak_alan
  acil_nokta
}

model BolgeNoktasi {
  id      String           @id @default(uuid())
  ad      String           @db.VarChar(150)
  tur     BolgeNoktasiTuru
  firmaId String?          @map("firma_id")
  firma   Firma?           @relation(fields: [firmaId], references: [id])
  enlem   Decimal          @db.Decimal(9, 6)
  boylam  Decimal          @db.Decimal(9, 6)

  cookzoneIsletmeleri   CookzoneIsletme[]
  acilDurumBildirimleri AcilDurumBildirimi[]
  paletTesisleri        PaletTesisi[]

  @@map("bolge_noktasi")
}

// ── 4.6 Cookzone (Faz 3) ──────────────────────────────────────────────────

model CookzoneIsletme {
  id             String       @id @default(uuid())
  ad             String       @db.VarChar(150)
  bolgeNoktasiId String       @map("bolge_noktasi_id")
  bolgeNoktasi   BolgeNoktasi @relation(fields: [bolgeNoktasiId], references: [id])

  menuOgeleri CookzoneMenuOgesi[]
  siparisler  CookzoneSiparis[]
  yetkilileri Kullanici[]

  @@map("cookzone_isletme")
}

model CookzoneMenuOgesi {
  id        String          @id @default(uuid())
  isletmeId String          @map("isletme_id")
  isletme   CookzoneIsletme @relation(fields: [isletmeId], references: [id])
  ad        String          @db.VarChar(150)
  aciklama  String?
  fiyat     Decimal         @db.Decimal(8, 2)
  kategori  String          @db.VarChar(60)
  gorselUrl String?         @map("gorsel_url") @db.VarChar(255)
  aktif     Boolean         @default(true)

  siparisKalemleri CookzoneSiparisKalemi[]

  @@map("cookzone_menu_ogesi")
}

// beklemede: işletmenin henüz kabul etmediği yeni sipariş. Yeni sipariş
// artık direkt alindi olarak başlamıyor, işletme siparişi elle kabul ediyor.
enum CookzoneSiparisDurumu {
  beklemede
  alindi
  hazirlaniyor
  hazir
  teslim_edildi
}

model CookzoneSiparis {
  id              String                @id @default(uuid())
  kullaniciId     String                @map("kullanici_id")
  kullanici       Kullanici             @relation(fields: [kullaniciId], references: [id])
  isletmeId       String                @map("isletme_id")
  isletme         CookzoneIsletme       @relation(fields: [isletmeId], references: [id])
  durum           CookzoneSiparisDurumu @default(beklemede)
  toplamTutar     Decimal               @map("toplam_tutar") @db.Decimal(10, 2)
  // Müşterinin "şu saatte gelip alacağım" dediği zaman — teslimat YOK,
  // randevulu hazır-olma modeli. `olusturmaTarihi`'nden (sipariş NE ZAMAN
  // verildi) kasıtlı olarak ayrı bir alan.
  alinmaSaati     DateTime              @map("alinma_saati")
  olusturmaTarihi DateTime              @default(now()) @map("olusturma_tarihi")

  kalemler CookzoneSiparisKalemi[]

  @@map("cookzone_siparis")
}

model CookzoneSiparisKalemi {
  id          String            @id @default(uuid())
  siparisId   String            @map("siparis_id")
  siparis     CookzoneSiparis   @relation(fields: [siparisId], references: [id])
  menuOgesiId String            @map("menu_ogesi_id")
  menuOgesi   CookzoneMenuOgesi @relation(fields: [menuOgesiId], references: [id])
  adet        Int

  @@map("cookzone_siparis_kalemi")
}

// ── 4.7 Acil Durum (Faz 3) ────────────────────────────────────────────────

enum AcilDurumTuru {
  yangin
  kaza
  saglik
  kantar
  gumruk
  diger
}

enum AcilDurumBildirimDurumu {
  yeni
  inceleniyor
  kapatildi
}

model AcilDurumBildirimi {
  id              String                  @id @default(uuid())
  kullaniciId     String                  @map("kullanici_id")
  kullanici       Kullanici               @relation(fields: [kullaniciId], references: [id])
  tur             AcilDurumTuru
  enlem           Decimal?                @db.Decimal(9, 6)
  boylam          Decimal?                @db.Decimal(9, 6)
  bolgeNoktasiId  String?                 @map("bolge_noktasi_id")
  bolgeNoktasi    BolgeNoktasi?           @relation(fields: [bolgeNoktasiId], references: [id])
  aciklama        String?
  durum           AcilDurumBildirimDurumu @default(yeni)
  olusturmaTarihi DateTime                @default(now()) @map("olusturma_tarihi")

  @@map("acil_durum_bildirimi")
}

// ── 4.8 Palet Tesisi (Faz 3) ──────────────────────────────────────────────
// Doğru adı "Palet Tesisi", "Paket Teslimi" değil. Alan adları (kargoFirmasi,
// takipNo, teslimNoktasi vb.) şimdilik böyle kalıyor — modül Faz 3'te henüz
// yazılmadı, iş kuralları netleşince alanlar gözden geçirilecek.

enum PaletTesisiDurumu {
  beklemede
  bolgede
  teslim_edildi
}

model PaletTesisi {
  id              String            @id @default(uuid())
  kullaniciId     String            @map("kullanici_id")
  kullanici       Kullanici         @relation(fields: [kullaniciId], references: [id])
  kargoFirmasi    String?           @map("kargo_firmasi") @db.VarChar(100)
  takipNo         String?           @map("takip_no") @db.VarChar(100)
  durum           PaletTesisiDurumu @default(beklemede)
  teslimNoktasiId String?           @map("teslim_noktasi_id")
  teslimNoktasi   BolgeNoktasi?     @relation(fields: [teslimNoktasiId], references: [id])
  olusturmaTarihi DateTime          @default(now()) @map("olusturma_tarihi")

  @@map("palet_tesisi")
}
model AcilDurumBilgisi {
  id              String   @id @default(uuid())
  tur             String   @unique @db.VarChar(50)
  telefon         String?  @db.VarChar(30)
  // Güvenlik/İtfaiye gibi birimlerde tek numara yetmiyor. Opsiyonel ikinci
  // hat, ilk numaranın yerini almaz, sadece ekstra bilgi satırı olarak gösterilir.
  telefon2        String?  @map("telefon_2") @db.VarChar(30)
  eposta          String?  @db.VarChar(150)
  adres           String?
  aciklama        String?
  calismaSaatleri String?  @map("calisma_saatleri")

  @@map("acil_durum_bilgisi")
}

model ToplanmaAlani {
  id        String   @id @default(uuid())
  ad        String   @db.VarChar(120)
  aciklama  String?
  enlem     Decimal  @db.Decimal(10, 7)
  boylam    Decimal  @db.Decimal(10, 7)
  aktif     Boolean  @default(true)
  sira      Int      @default(0)

  @@map("toplanma_alani")
}
model PaletTesisiBilgisi {
  id              String  @id @default(uuid())
  telefon         String? @db.VarChar(30)
  eposta          String? @db.VarChar(150)
  adres           String?
  aciklama        String?
  calismaSaatleri String? @map("calisma_saatleri")

  @@map("palet_tesisi_bilgisi")
}

model Palet {
  id        String  @id @default(uuid())
  ad        String  @db.VarChar(120)
  aciklama  String?
  olcu      String? @db.VarChar(80)
  gorselUrl String? @map("gorsel_url")
  aktif     Boolean @default(true)
  sira      Int     @default(0)

  @@map("palet")
}

// ── 4.9 Bildirimler ─────────────────────────────────────────────────────
// Cookzone'un "sipariş hazır" bildirimi için eklendi, ama sadece Cookzone'a
// özel değil. Acil Durum ve Duyurular da ileride bu tabloyu kullanacak, bu
// yüzden kendi Cookzone bölümünde değil ayrı bir bölümde duruyor.

enum CihazPlatformu {
  android
  ios
  web
}

model CihazTokeni {
  id              String         @id @default(uuid())
  kullaniciId     String         @map("kullanici_id")
  kullanici       Kullanici      @relation(fields: [kullaniciId], references: [id])
  // Bir kullanıcının aynı cihazda birden fazla token kaydı birikmemesi için
  // unique — FCM token'ı yenilendiğinde upsert edilir, çoğaltılmaz.
  token           String         @unique @db.VarChar(255)
  platform        CihazPlatformu
  olusturmaTarihi DateTime       @default(now()) @map("olusturma_tarihi")

  @@map("cihaz_tokeni")
}
